# ----------------------
# Bloc HTTP → redirection HTTPS
# ----------------------
server {
    listen 80;
    server_name monsite.fr www.monsite.fr;

    # Certbot va créer automatiquement /.well-known lors du challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirection HTTP vers HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ----------------------
# Bloc HTTPS sécurisé
# ----------------------
server {
    listen 443 ssl http2;
    server_name monsite.fr www.monsite.fr;

    root /var/www/monsite;
    index index.html index.php;

    # Certificats Let’s Encrypt
    ssl_certificate /etc/letsencrypt/live/monsite.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monsite.fr/privkey.pem;

    # SSL / TLS sécurité
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256';
    ssl_prefer_server_ciphers on;

    # Session SSL
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets on;

    # OCSP stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/monsite.fr/chain.pem;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 3s;

    # DH params
    ssl_dhparam /etc/nginx/ssl/dhparam.pem;

    # Sécurisation des headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";

    # ----------------------
    # Gestion des fichiers
    # ----------------------
    location / {
        try_files $uri $uri/ =404;
    }

    # PHP-FPM (si tu utilises PHP)
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock; # Vérifie la version PHP
